<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="ur_robot" params="name parent *origin">

    <!-- Load hardware configuration parameters from YAML -->
    <xacro:property name ="config_file"
		    value="$(find aist_bringup)/config/devices/devices.yaml"/>
    <xacro:property name ="config"
		    value="${xacro.load_yaml(config_file)[name]}"/>

    <!-- parameters -->
    <xacro:property name ="ur_type"
		    value="${config.get('ur_type', 'ur5e')}"/>
    <xacro:property name ="tf_prefix"
		    value="${name}_"/>
    <xacro:property name="joint_limit_params"
		    value="$(find ur_description
			   )/config/${ur_type}/joint_limits.yaml"/>
    <xacro:property name ="physical_params"
		    value="$(find ur_description
			   )/config/${ur_type}/physical_parameters.yaml"/>
    <xacro:property name ="visual_params"
		    value="$(find ur_description
			   )/config/${ur_type}/visual_parameters.yaml"/>
    <xacro:property name ="kinematics_params"
		    value="$(find aist_description
			   )/scenes/calib/${name}.yaml"/>
    <xacro:property name ="safety_limits"
		    value="${config.get('safety_limits', 'false')}"/>
    <xacro:property name ="safety_pos_margin"
		    value="${str(config.get('safety_limits', 0.15))}"/>
    <xacro:property name ="safety_k_position"
		    value="${str(config.get('safety_k_position', 20))}"/>
    <xacro:property name ="force_abs_paths"
		    value="${config.get('force_abs_paths', 'false')}"/>

    <!-- UR arm -->
    <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
    <xacro:ur_robot
	name="${name}"
	tf_prefix="${name}_"
	parent="${parent}"
	joint_limits_parameters_file="$(find ur_description
				      )/config/${ur_type}/joint_limits.yaml"
	physical_parameters_file="$(find ur_description
				  )/config/${ur_type}/physical_parameters.yaml"
	visual_parameters_file="$(find ur_description
				)/config/${ur_type}/visual_parameters.yaml"
	kinematics_parameters_file="$(find aist_description
				    )/scenes/calib/${name}.yaml"
	safety_limits="${safety_limits}"
	safety_pos_margin="${safety_pos_margin}"
	safety_k_position="${safety_k_position}"
	force_abs_paths="${force_abs_paths}">
      <xacro:insert_block name="origin"/>
    </xacro:ur_robot>

  </xacro:macro>

</robot>
