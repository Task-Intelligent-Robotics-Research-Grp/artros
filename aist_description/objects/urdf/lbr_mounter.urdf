<?xml version="1.0" ?>
<robot name="aaa" xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include filename="$(find aist_description)/objects/urdf/lbr_mounter.urdf.xacro"/>

  <link name="base_link"/>

  <xacro:lbr_mounter prefix="lbr_mounter_" parent="base_link">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:lbr_mounter>
</robot>
