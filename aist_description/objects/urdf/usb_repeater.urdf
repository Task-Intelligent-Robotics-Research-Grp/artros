<?xml version="1.0" ?>
<robot name="aaa" xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include filename="$(find aist_description)/objects/urdf/usb_repeater.urdf.xacro"/>

  <link name="base_link"/>

  <xacro:usb_repeater prefix="usb_repeater_" parent="base_link">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:usb_repeater>
</robot>
