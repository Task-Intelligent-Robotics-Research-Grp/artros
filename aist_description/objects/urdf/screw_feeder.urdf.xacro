<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="screw_feeder">

  <xacro:macro name="screw_feeder" params="prefix parent *origin">

    <xacro:property name="length"		value=".126"/>
    <xacro:property name="front_width"		value=".056"/>
    <xacro:property name="front_height"		value=".081"/>
    <xacro:property name="front_left_length"	value=".055"/>
    <xacro:property name="front_right_length"	value=".040"/>
    <xacro:property name="back_width"		value=".126"/>
    <xacro:property name="back_height"		value=".147"/>

    <xacro:property name="gap_width"	value="${length - front_left_length
						- front_right_length}"/>
    <xacro:property name="gap_depth"	value=".013"/>
    <xacro:property name="gap_height"	value="${front_height - gap_depth}"/>
    <xacro:property name="gap_x"	value=".046"/>
    <xacro:property name="gap_y"	value="${length/2}"/>

    <xacro:include filename="$(find aist_description
			     )/objects/urdf/aist_box.urdf.xacro" />

    <!-- Back side -->
    <xacro:aist_box name="${prefix}base_link" parent="${parent}"
		    width="${back_width}" length="${length}"
		    height="${back_height}"
		    rgba="0.2 0.2 0.2 1.0">
      <xacro:insert_block name="origin"/>
    </xacro:aist_box>

    <!-- Front left side -->
    <xacro:aist_box name="${prefix}front_left_side" parent="${prefix}base_link"
		    width="${front_width}" length="${front_left_length}"
		    height="${front_height}"
		    rgba="0.2 0.2 0.2 1.0">
      <origin xyz="${back_width} 0 0" rpy="0 0 0"/>
    </xacro:aist_box>

    <!-- Front right side -->
    <xacro:aist_box name="${prefix}front_right_side" parent="${prefix}base_link"
		    width="${front_width}" length="${front_right_length}"
		    height="${front_height}"
		    rgba="0.2 0.2 0.2 1.0">
      <origin xyz="${back_width} ${front_left_length + gap_width} 0"
	      rpy="0 0 0"/>
    </xacro:aist_box>

    <!-- Gap -->
    <xacro:aist_box name="${prefix}gap" parent="${prefix}front_left_side"
		    width="${front_width}" length="${gap_width}"
		    height="${gap_height}"
		    rgba="0.6 0.6 0.6 1.0">
      <origin xyz="0 ${front_left_length} 0" rpy="0 0 0"/>
    </xacro:aist_box>

    <joint name="${prefix}outlet_joint" type="fixed">
      <parent link="${prefix}gap"/>
      <child  link="${prefix}outlet_link"/>
      <origin xyz="${gap_x} ${gap_y - front_left_length} ${gap_height}"
	      rpy="0 0 0"/>
    </joint>
    <link name="${prefix}outlet_link"/>

    <joint name="${prefix}inlet_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}inlet_link"/>
      <origin xyz="0.072 0.032 ${back_height}" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}inlet_link"/>

  </xacro:macro>

</robot>
