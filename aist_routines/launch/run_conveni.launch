<?xml version="1.0" ?>
<launch>

  <!-- Start conveni client -->
  <node name="conveni" pkg="aist_routines" type="run_conveni.py"
	clear_params="true" output="screen">
    <rosparam file="$(find aist_routines)/config/g_bot_config.yaml"/>
    <rosparam file="$(find aist_routines)/config/conveni.yaml"/>
  </node>

</launch>
