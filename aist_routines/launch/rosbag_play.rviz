Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TF1/Status1
        - /TF1/Frames1
        - /MultiplexerImage1
        - /DepthCloud1/Auto Size1
      Splitter Ratio: 0.7242105007171631
    Tree Height: 407
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: MultiplexerImage
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
