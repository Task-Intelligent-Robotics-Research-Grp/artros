<?xml version="1.0" ?>
<launch>

  <arg name="robot_name"	default="b_bot"/>

  <!-- Start spacenav driver node -->
  <node name="spacenav_node"
	pkg="spacenav_node" type="spacenav_node" output="screen">
    <param name="zero_when_static"		value="true"/>
    <param name="static_count_threshold"	value="30"/>
    <rosparam param="linear_scale">[0.1,0.1,0.1]</rosparam>
    <rosparam param="angular_scale">[0.5,0.5,0.5]</rosparam>
  </node>

  <!-- Numerically integrate twists into a pose -->
  <node name="spacenav_to_pose"
	pkg="cartesian_controller_utilities" type="pose.py" output="screen">
    <param name="twist_topic"		value="/spacenav/twist"/>
    <param name="pose_topic"		value="$(arg robot_name)/target_frame"/>
    <param name="frame_id"		value="$(arg robot_name)_base_link"/>
    <param name="end_effector"		value="$(arg robot_name
					       )_gripper_tip_link"/>
    <param name="publishing_rate"	value="100"/>
  </node>

</launch>
