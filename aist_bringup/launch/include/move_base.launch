<?xml version="1.0"?>
<launch>

  <arg name="holonomic_robot"		default="false"/>
  <arg name="base_controller"		default="base_controller"/>
  <arg name="no_static_map"		default="false"/>
  <arg name="base_global_planner"       default="navfn/NavfnROS"/>
  <arg name="base_local_planner"
       default="dwa_local_planner/DWAPlannerROS"/>
  <!-- <arg name="base_local_planner" -->
  <!--      default="base_local_planner/TrajectoryPlannerROS"/> -->

  <node name="move_base"
	pkg="move_base" type="move_base" respawn="false" output="screen">
    <param name="base_global_planner"	value="$(arg base_global_planner)"/>
    <param name="base_local_planner"	value="$(arg base_local_planner)"/>
    <rosparam file="$(dirname)/../../config/move_base/planner.yaml"
	      subst_value="true"/>

    <!-- observation sources located in costmap_common.yaml -->
    <rosparam ns="global_costmap"
	      file="$(dirname)/../../config/move_base/costmap_common.yaml"/>
    <rosparam ns="local_costmap"
	      file="$(dirname)/../../config/move_base/costmap_common.yaml"/>

    <!-- local costmap, needs size -->
    <rosparam ns="local_costmap"
	      file="$(dirname)/../../config/move_base/costmap_local.yaml"/>
    <param name="local_costmap/width"	value="10.0"/>
    <param name="local_costmap/height"	value="10.0"/>

    <!-- static global costmap, static map provides size -->
    <rosparam unless="$(arg no_static_map)"
	      ns="global_costmap"
	      file="$(dirname
		    )/../../config/move_base/costmap_global_static.yaml"/>

    <!-- global costmap with laser, for odom_navigation_demo -->
    <rosparam if="$(arg no_static_map)"
	      ns="global_costmap"
	      file="$(dirname)/../../config/move_base/costmap_global.yaml"/>
    <param if="$(arg no_static_map)"
	   name="global_costmap/width"	value="100.0"/>
    <param if="$(arg no_static_map)"
	   name="global_costmap/height"	value="100.0"/>

    <remap from="odom"		to="$(arg base_controller)/odom"/>
    <remap from="cmd_vel"	to="$(arg base_controller)/cmd_vel"/>
  </node>

</launch>
