<launch>

  <arg name="robot_description"	default="robot_description"/>
  <arg name="scene"		default=""/>
  <arg name="product"		default="$(optenv PRODUCT default)"/>
  <arg name="static"		default="true"/>
  <arg name="moveit"		default="true"/>
  <arg name="snapshot"		default="false" />

  <!-- GDB functionality -->
  <arg name="debug"	default="false" />

  <!-- Gazebo verbose -->
  <arg name="verbose"	default="false" />

  <!-- Common -->
  <!-- <include file="$(dirname)/include/torobo_bringup_common.launch"> -->
  <!--   <arg name="scene"			value="$(arg scene)"/> -->
  <!--   <arg name="sim"			value="true"/> -->
  <!--   <arg name="robot_description"	value="$(arg robot_description)"/> -->
  <!--   <arg name="product"			value="$(arg product)"/> -->
  <!--   <arg name="moveit"			value="$(arg moveit)"/> -->
  <!--   <arg name="static"			value="$(arg static)"/> -->
  <!--   <arg name="snapshot"		value="$(arg snapshot)"/> -->
  <!-- </include> -->
  <include file="$(dirname)/include/airec3_bringup_common.launch">
    <arg name="scene"			value="$(arg scene)"/>
    <arg name="sim"			value="true"/>
    <arg name="robot_description"	value="$(arg robot_description)"/>
    <arg name="product"			value="$(arg product)"/>
    <arg name="moveit"			value="$(arg moveit)"/>
    <arg name="static"			value="$(arg static)"/>
    <arg name="snapshot"		value="$(arg snapshot)"/>
  </include>

  <!-- Gazebo -->
  <arg name="gazebo_gui"	default="true"/>
  <arg name="gazebo_world"	default="$(find torobo_gazebo
					 )/worlds/ground_plane.world"/>
  <arg name="paused"		default="false" />
  <include file="$(dirname)/include/torobo_world.launch">
    <arg name="debug"			value="$(arg debug)"/>
    <arg name="verbose"			value="$(arg verbose)"/>
    <arg name="robot_description"	value="airec3_description"/>
    <arg name="product"			value="$(arg product)" />
    <arg name="paused"			value="$(arg paused)" />
    <arg name="gui"			value="$(arg gazebo_gui)" />
    <arg name="world"			value="$(arg gazebo_world)"/>
  </include>

  <!-- If 'scene' is not empty, load environment URDF to the parameter
       'environment_description' and set it to Gazebo. -->
  <group unless="$(eval scene == '')">
    <param name="environment_description"
	   command="$(find xacro)/xacro '$(find aist_description
		    )/scenes/urdf/$(arg scene)_environment.urdf.xacro'"/>
    <node name="environment_spawner" pkg="gazebo_ros" type="spawn_model"
	  respawn="false" output="screen"
	  args="-urdf -model environment -param environment_description
		-unpause"/>
  </group>

</launch>
