# Doxyfile configuration file

# Set the project name
PROJECT_NAME           = artros

FILTER_PATTERNS        = *.py="doxypypy -a -c"

OUTPUT_DIRECTORY       = docs

USE_MDFILE_AS_MAINPAGE = ./README.md

FULL_PATH_NAMES        = NO

EXTRACT_ALL            = NO

EXTRACT_STATIC         = YES

EXTRACT_ANON_NSPACES   = NO

EXTRACT_PRIVATE        = NO

HIDE_UNDOC_MEMBERS     = YES

RECURSIVE              = YES

EXCLUDE                = artros_msgs aist_camera_calibration */scripts */launch */setup.py

SOURCE_BROWSER         = YES

REFERENCED_BY_RELATION = NO

REFERENCES_RELATION    = NO


GENERATE_LATEX         = NO

CALL_GRAPH             = NO

CALLER_GRAPH           = NO
