<?xml version="1.0"?>
<robot name="robotiq_3f_gripper" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="prefix" default=""/>

  <link name="world"/>

  <xacro:include filename="$(find aist_robotiq
			   )/urdf/robotiq_3f_gripper.urdf.xacro" />
  <xacro:robotiq_3f_gripper prefix="$(arg prefix)" parent="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_3f_gripper>

  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/</robotNamespace>
    </plugin>
  </gazebo>

</robot>
