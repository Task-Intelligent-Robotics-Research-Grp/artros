<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>aist_ftsensor</name>
  <version>0.0.0</version>
  <description>The aist_ftsensor package</description>

  <author>Toshio UESHIBA</author>
  <maintainer email="t.ueshiba@aist.go.jp">Toshio UESHIBA</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rclcpp_components</build_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <build_depend>hardware_interface</build_depend>

  <depend>controller_manager</depend>
  <depend>controller_interface</depend>
  <depend>realtime_tools</depend>
  <depend>pluginlib</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>boost</depend>
  <depend>eigen</depend>
  <depend>aist_utility</depend>
  <depend>ddynamic_reconfigure2</depend>
  <depend>kdl_parser</depend>

  <build_export_depend>hardware_interface</build_export_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <controller_interface plugin="${prefix}/aist_ftsensor_plugin.xml"/>
  </export>
</package>
