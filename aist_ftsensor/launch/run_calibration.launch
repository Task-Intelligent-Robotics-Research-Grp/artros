<?xml version="1.0" ?>
<launch>

  <arg name="config"		default="aist"/>
  <arg name="robot_name"	default="a_bot"/>
  <arg name="with_org"		default="false"/>

  <node name="run_calibration"
	pkg="aist_ftsensor" type="run_calibration.py" output="screen">
    <rosparam file="$(find aist_routines)/config/$(arg config)_config.yaml"/>
    <rosparam file="$(dirname)/../config/$(arg robot_name)_ftsensor.yaml"/>
  </node>

  <include file="$(dirname)/plot.launch">
    <arg name="robot_name"	value="$(arg robot_name)"/>
    <arg name="with_org"	value="$(arg with_org)"/>
  </include>

</launch>
