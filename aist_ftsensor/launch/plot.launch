<?xml version="1.0" ?>
<launch>

  <arg name="robot_name"	default="a_bot"/>
  <arg name="with_org"		default="false"/>

  <arg name="forces"
       value="$(arg robot_name)/wrench/wrench/force/x
	      $(arg robot_name)/wrench/wrench/force/y
	      $(arg robot_name)/wrench/wrench/force/z"/>
  <arg name="torques"
       value="$(arg robot_name)/wrench/wrench/torque/x
	      $(arg robot_name)/wrench/wrench/torque/y
	      $(arg robot_name)/wrench/wrench/torque/z"/>
  <arg name="forces_org"
       value="$(arg robot_name)/wrench_org/wrench/force/x
	      $(arg robot_name)/wrench_org/wrench/force/y
	      $(arg robot_name)/wrench_org/wrench/force/z"/>
  <arg name="torques_org"
       value="$(arg robot_name)/wrench_org/wrench/torque/x
	      $(arg robot_name)/wrench_org/wrench/torque/y
	      $(arg robot_name)/wrench_org/wrench/torque/z"/>

  <arg if="$(arg with_org)"
       name="forces_args"	value="$(arg forces) $(arg forces_org)"/>
  <arg unless="$(arg with_org)"
       name="forces_args"	value="$(arg forces)"/>
  <arg if="$(arg with_org)"
       name="torques_args"	value="$(arg torques) $(arg torques_org)"/>
  <arg unless="$(arg with_org)"
       name="torques_args"	value="$(arg torques)"/>

  <node name="plot_forces" pkg="rqt_plot" type="rqt_plot"
	clear_params="true" args="$(arg forces_args)"/>
  <node name="plot_torques" pkg="rqt_plot" type="rqt_plot"
	clear_params="true" args="$(arg torques_args)"/>

</launch>
