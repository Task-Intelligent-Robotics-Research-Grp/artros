<launch>

  <arg name="product" default="$(optenv PRODUCT default)" />

  <!-- benchmark options file -->
  <arg name="bench_opts" default="$(dirname)/../config/benchmark.yaml"/>

  <!-- Load robot settings -->
  <include file="$(dirname)/planning_context.launch">
    <arg name="product" value="$(arg product)"/>
    <arg name="load_robot_description" value="true"/>
  </include>

  <!-- Load all planning pipelines that will be benchmarked -->
  <include ns="moveit_run_benchmark" file="$(dirname)/planning_pipeline.launch.xml">
    <arg name="product" value="$(arg product)"/>
    <arg name="pipeline" value="ompl" />
  </include>

  <!-- Load warehouse containing scenes and queries to benchmark -->
  <arg name="db_path" default="$(dirname)/../default_warehouse_mongo_db" />
  <include file="$(dirname)/default_warehouse_db.launch">
    <arg name="moveit_warehouse_database_path" value="$(arg db_path)"/>
  </include>

  <!-- Launch benchmark node -->
  <node name="moveit_run_benchmark" pkg="moveit_ros_benchmarks" type="moveit_run_benchmark" output="screen" required="true">
    <rosparam command="load" file="$(arg bench_opts)"/>
  </node>

</launch>
