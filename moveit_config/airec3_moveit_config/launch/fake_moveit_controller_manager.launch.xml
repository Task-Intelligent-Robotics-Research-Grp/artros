<launch>

  <arg name="product" />
  <arg name="config_dir" default="$(optenv TR_CONFIG_DIR /tmp/)"/>

  <!-- Set the param that trajectory_execution_manager needs to find the controller plugin -->
  <param name="moveit_controller_manager" value="moveit_fake_controller_manager/MoveItFakeControllerManager"/>

  <!-- The rest of the params are specific to this plugin -->
  <!-- load controller_list -->
  <param name="/dummy" command="
      $(dirname)/../scripts/load_controller_list
      --model_dir=$(find torobo_description)/config/models
      --yaml=controllers.yaml
      --robot_config=$(find torobo_description)/config/products/$(arg product).yaml
      --fake
      --dump_file=$(arg config_dir)/torobo_rosparam_fake_controller_list.yaml
      " />
  <rosparam command="load" file="$(arg config_dir)/torobo_rosparam_fake_controller_list.yaml" />

  <param name="/dummy" command="
      $(dirname)/../scripts/load_initial_pose
      --model_dir=$(find torobo_description)/config/models
      --srdf=torobo.srdf
      --robot_config=$(find torobo_description)/config/products/$(arg product).yaml
      --dump_file=$(arg config_dir)/torobo_rosparam_fake_controller_initial_pose.yaml
  " />
  <rosparam command="load" file="$(arg config_dir)/torobo_rosparam_fake_controller_initial_pose.yaml" />

</launch>
